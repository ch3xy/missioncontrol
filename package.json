{
  "name": "missioncontrol",
  "version": "0.1.3",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-with-build-info.mjs serve",
    "build": "node scripts/ng-with-build-info.mjs build",
    "build:pi": "node scripts/ng-with-build-info.mjs build --base-href /missioncontrol/",
    "watch": "node scripts/ng-with-build-info.mjs build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"docs/**/*.md\" README.md package.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"docs/**/*.md\" README.md package.json",
    "lint": "npm run typecheck && npm run format:check"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/angular": "^1.59.0",
    "ical.js": "^2.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
